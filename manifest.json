{
  "manifest_version": 3,
  "name": "Sound Scheduler",
  "version": "1.0",
  "description": "Plays a sound exactly every minute on the clock",
  "permissions": ["alarms", "offscreen", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["sound.ogg"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "quickoptions.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
